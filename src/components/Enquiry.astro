---
import type {Language} from '../lib/routes';import {ui} from '../data/ui';import ArrowLink from './ArrowLink.astro';import {whatsappLink} from '../lib/enquiry';import {dataNotice} from '../data/legal';import {route} from '../lib/routes';import {brand} from '../data/brand';
interface Props{lang:Language;property?:string;intent?:'buy'|'sell'|'rent';heading?:string;direct?:boolean;alone?:boolean;}
const {lang,property,intent='buy',heading,direct=true}=Astro.props;const t=ui[lang];const dear=t.dear;const aside=Astro.slots.has('aside');
// The letter is sent from the website once delivery is configured (RESEND_API_KEY, read at build time); until then it opens the visitor's email app.
const delivers=Boolean(import.meta.env.RESEND_API_KEY);
// Under the button, a link to the privacy page, where the data protection information is.
const notice=dataNotice[lang];
const cut=(phrase:string)=>phrase.lastIndexOf(' ')+1;const head=(phrase:string)=>phrase.slice(0,cut(phrase));const tail=(phrase:string)=>phrase.slice(cut(phrase));
---
{/* The letter: one sentence with blanks to fill in, then an optional message. On the contact page,
     Soumaya's note takes the place of the heading column (the "aside" slot), on the same warm band.
     On every other page, the left column carries the heading and the direct call/WhatsApp/email block. */}
<div class={aside?'personal contact-band':'personal'}><section id="contact" class={aside?'contact contact-sheet wrap':'contact wrap'}>{aside?<slot name="aside"/>:<div><h2>{heading??(property?t.seeHere:t.start)}</h2>{direct&&<div class="contact-direct-line"><p class="caption">{t.directLabel}</p><ArrowLink href={`tel:${brand.phoneHref}`}>{brand.phone}</ArrowLink><ArrowLink href={whatsappLink(lang,property)} target="_blank" rel="noopener">WhatsApp</ArrowLink><ArrowLink href={`mailto:${brand.email}`}>{brand.email}</ArrowLink></div>}</div>}
<form novalidate data-enquiry data-delivers={delivers?'true':undefined} data-lang={lang} data-property={property||''} data-plans={property?t.plansMessage:undefined} data-errors={JSON.stringify({name:t.nameError,contact:t.contactError,email:t.emailError,summary:t.formError})}>
<div class="letter-fields">
<p class="salutation">{dear}</p>
<p class="phrase">{property?<span class="property-context">{t.propertyContext} {property}. </span>:<span class="intent"><label for="intent">{t.intent}</label> <select id="intent" name="intent"><option value="buy" selected={intent==='buy'}>{t.buy}</option><option value="sell" selected={intent==='sell'}>{t.sell}</option><option value="rent" selected={intent==='rent'}>{t.rent}</option></select> {t.intentEnd} </span>}<span class="writing-for"><label for="writing-for">{t.writingFor}</label> <select id="writing-for" name="writingFor"><option value="self" selected>{t.forMyself}</option><option value="client">{t.forClient}</option></select>. </span><label class="blank-label" for="name">{head(t.name)}<span class="pair">{tail(t.name)} <input class="blank blank-name" id="name" name="name" autocomplete="name" placeholder={t.namePlaceholder} required aria-describedby="contact-help name-error" maxlength="120"/></span></label> <label class="blank-label" for="phone">{head(t.phone)}<span class="pair">{tail(t.phone)} <input class="blank blank-phone" id="phone" name="phone" type="tel" autocomplete="tel" placeholder={t.phonePlaceholder} aria-describedby="contact-help contact-error" maxlength="60"/></span></label> <label class="blank-label" for="email">{head(t.email)}<span class="pair">{tail(t.email)} <input class="blank blank-email" id="email" name="email" type="email" autocomplete="email" autocapitalize="none" placeholder={t.emailPlaceholder} aria-describedby="contact-help contact-error email-error" maxlength="254"/></span></label><span class="prefer-language"><span class="stop">. </span><label for="talk-language">{t.preferLanguage}</label> <select id="talk-language" name="language">{(['fr','en','es','ar'] as const).map(code=><option value={code} selected={code===lang}>{t[code==='en'?'langEn':code==='es'?'langEs':code==='fr'?'langFr':'langAr']}</option>)}</select>.</span></p>
<p class="contact-help" id="contact-help">{t.help}</p>
<p class="error" id="name-error"></p><p class="error" id="contact-error"></p><p class="error" id="email-error"></p>
<div class="field"><label for="message">{t.message} <span>({t.optional})</span>:</label><textarea id="message" name="message" rows="3" maxlength="2500"></textarea></div>
<p class="error" role="alert" id="form-status"></p>
{/* One step: the letter above is the preview. The button opens the visitor's email app with it. */}
<p class="trap" aria-hidden="true"><label>{t.leaveEmpty} <input name="website" tabindex="-1" autocomplete="off"/></label></p>
{delivers?<button type="submit" class="button primary" data-sending={t.sending}>{t.sendDirect}</button>:<button type="submit" class="button primary">{t.sendLetter} <span aria-hidden="true">↗</span></button>}<p class="preview-note">{delivers?t.sendDirectNote:t.sendNote}</p><noscript><p>{({en:'Email me directly at',es:'Escríbeme directamente a',fr:'Écrivez-moi directement à'})[lang]} <a href={`mailto:${brand.email}`}>{brand.email}</a>.</p></noscript>
<p class="data-notice"><a href={route(lang,'privacy')}>{notice}</a></p>
</div>
{/* Shown once the letter is handed to the email app. Honest about what happened, with ways forward if it did not open. */}
<section class="confirmation" tabindex="-1" aria-labelledby="confirmation-heading" hidden>
 <h3 id="confirmation-heading" data-thanks={t.thanks}></h3>
 <p class="confirmation-body" data-sent={t.sentBody} data-handed={t.handedOff} data-failed={`${t.sendFailed} ${t.handedOff}`}>{t.handedOff}</p>
 <div class="confirmation-fallback"><p class="confirmation-label">{t.notOpened}</p>
 <div class="confirmation-actions"><button type="button" class="button" data-copy>{t.copyLetter}</button><ArrowLink class="button" data-compose href={`mailto:${brand.email}`}>{t.openAgain}</ArrowLink><ArrowLink class="text-link" data-whatsapp href={whatsappLink(lang,property)} target="_blank" rel="noopener">{t.whatsappLetter}</ArrowLink></div>
 <p class="copy-status" aria-live="polite" data-copied={t.copied}></p></div>
 <details class="letter-details"><summary>{t.yourLetter}</summary><p class="letter-preview"></p></details>
 <button type="button" class="text-link edit">{t.edit} <span aria-hidden="true">↑</span></button>
</section>
</form></section></div>
<script>
import {validateEnquiry,enquiryText,emailLink,whatsappLink,type Enquiry} from '../lib/enquiry';
for(const form of document.querySelectorAll<HTMLFormElement>('[data-enquiry]')){
 const input=(name:string)=>form.elements.namedItem(name) as HTMLInputElement;
 const fields=form.querySelector<HTMLElement>('.letter-fields')!;
 const confirmation=form.querySelector<HTMLElement>('.confirmation')!;
 const status=form.querySelector<HTMLElement>('#form-status')!;
 const copyStatus=form.querySelector<HTMLElement>('.copy-status')!;
 const lang=form.dataset.lang==='es'?'es':form.dataset.lang==='fr'?'fr':'en';const copy=JSON.parse(form.dataset.errors!);
 let letter='';
 const clear=()=>{form.querySelectorAll('[aria-invalid]').forEach(el=>el.removeAttribute('aria-invalid'));form.querySelectorAll('.error').forEach(el=>el.textContent='');};
 const editing=(focus=true)=>{confirmation.hidden=true;fields.hidden=false;copyStatus.textContent='';if(focus)input('name').focus();};
 form.addEventListener('input',clear);
 // "Request floor plans" (in the details) and "Discreet, when you prefer" (on Sell) write into the message, where the visitor can see it.
 const plansLine=form.dataset.plans;
 for(const link of document.querySelectorAll('[data-request-plans]'))link.addEventListener('click',()=>{editing(false);const message=input('message');if(plansLine&&!message.value.includes(plansLine))message.value=message.value?`${message.value}\n${plansLine}`:plansLine;});
 for(const link of document.querySelectorAll<HTMLElement>('[data-discreet]'))link.addEventListener('click',()=>{editing(false);const line=link.dataset.discreet;const message=input('message');if(line&&!message.value.includes(line))message.value=message.value?`${message.value}\n${line}`:line;});
 const button=form.querySelector<HTMLButtonElement>('button[type=submit]')!;
 // Shows the confirmation: "sent" once the website has delivered the letter, otherwise the email-app
 // handoff (with its fallbacks), prefixed with an explanation if direct delivery failed.
 const confirm=(state:'sent'|'handed'|'failed',name:string)=>{
  const heading=confirmation.querySelector<HTMLElement>('h3')!;heading.textContent=heading.dataset.thanks!.replace('{name}',name.trim().split(/\s+/)[0]);
  const body=confirmation.querySelector<HTMLElement>('.confirmation-body')!;body.textContent=body.dataset[state]!;
  confirmation.dataset.state=state==='sent'?'sent':'handed';
  fields.hidden=true;confirmation.hidden=false;confirmation.focus();
 };
 form.addEventListener('submit',async event=>{
  event.preventDefault();clear();
  if(button.disabled)return;
  const data:Enquiry={name:input('name').value,phone:input('phone').value,email:input('email').value,message:input('message').value,intent:input('intent')?.value==='sell'?'sell':input('intent')?.value==='rent'?'rent':'buy',property:form.dataset.property||undefined,floorPlans:false,writingFor:input('writingFor').value==='client'?'client':'self',language:(['en','es','fr','ar'] as const).find(code=>code===input('language').value)};
  const errors=validateEnquiry(data);let first:HTMLInputElement|undefined;
  for(const key of ['name','contact','email'] as const){if(errors[key]){const target=input(key==='contact'?'phone':key);target.setAttribute('aria-invalid','true');if(key==='contact')input('email').setAttribute('aria-invalid','true');form.querySelector(`#${key}-error`)!.textContent=copy[key];first??=target;}}
  if(first){status.textContent=copy.summary;first.focus();return;}
  // Visit counts (Vercel Web Analytics, live site only): a letter written, and how it left the site.
  const counted=(result:string)=>(window as any).va?.('event',{name:'Letter',data:{page:location.pathname,result}});
  letter=enquiryText(data,lang);const compose=emailLink(letter,data.property,lang);
  form.querySelector('.letter-preview')!.textContent=letter;
  form.querySelector<HTMLAnchorElement>('[data-compose]')!.href=compose;
  form.querySelector<HTMLAnchorElement>('[data-whatsapp]')!.href=whatsappLink(lang,data.property,letter);
  if(form.dataset.delivers){
   const label=button.innerHTML;button.disabled=true;button.setAttribute('aria-busy','true');button.textContent=button.dataset.sending!;
   let sent=false;
   try{const response=await fetch('/api/enquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...data,lang,website:input('website').value})});sent=response.ok;}catch{}
   button.disabled=false;button.removeAttribute('aria-busy');button.innerHTML=label;
   if(sent){counted('sent');confirm('sent',data.name);return;}
   counted('failed');confirm('failed',data.name);window.location.href=compose;return;
  }
  counted('email app');confirm('handed',data.name);
  window.location.href=compose;
 });
 form.querySelector('[data-copy]')!.addEventListener('click',async()=>{
  try{await navigator.clipboard.writeText(letter);copyStatus.textContent=copyStatus.dataset.copied!;}
  catch{const details=form.querySelector<HTMLDetailsElement>('.letter-details')!;details.open=true;getSelection()?.selectAllChildren(form.querySelector('.letter-preview')!);}
 });
 form.querySelector('.edit')!.addEventListener('click',()=>editing());
}
</script>
