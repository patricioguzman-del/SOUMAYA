---
// The homepage of a personal property advisor: the promise and three doors (buy, sell, holiday rentals),
// how she works, selected homes, holiday rentals, Meet Soumaya, a private conversation, then the island
// (as Patricio asked, 23 Nov), on a light band so the page does not end on two dark blocks.
import Photo from './Photo.astro';import ArrowLink from './ArrowLink.astro';import ServiceIcon from './ServiceIcon.astro';
import {money} from '../lib/format';import {ui} from '../data/ui';import {route,type Language} from '../lib/routes';
import {facadeOf,hrefOf,type Listing} from '../lib/listings';import {homepage} from '../data/homepage';
interface Props{lang:Language;properties:Listing[];}
const {lang,properties}=Astro.props;const t=ui[lang];
const available=properties.filter(property=>property.status==='for-sale');
const chosen=homepage.featured.map(reference=>available.find(property=>property.reference===reference)).filter((listing):listing is Listing=>Boolean(listing));
const featured=[...chosen,...available.filter(listing=>!chosen.includes(listing))].slice(0,3);
const heroHome=featured[0]?facadeOf(featured[0],lang):{image:homepage.perspective,alt:''};
const place=(listing:Listing)=>listing[lang].location.split('·')[0].trim();
const doorPages=['buy','sell','rentals'] as const;const doorIcons=[0,1,3];
---
<section class="hero" aria-labelledby="home-title">
 {/* Soumaya prefers not to open the site with her portrait (23 Nov): the hero shows the first selected home. */}
 <Photo image={heroHome.image} class="hero-portrait hero-house" imageClass="hero-image" alt={heroHome.alt} eager sizes="(max-width:760px) 100vw, 46vw"/>
 <div class="hero-copy">
  <p class="eyebrow">{t.homeEyebrow}</p>
  <h1 id="home-title">{t.homeTitle}</h1>
  <p class="hero-lead">{t.homeLead}</p>
  <div class="hero-buttons"><ArrowLink class="button solid" href={route(lang,'contact')}>{t.startSearch}</ArrowLink><a class="button" href={route(lang,'about')}>{t.meet}</a></div>
 </div>
</section>

<section class="doors wrap" aria-label={`${t.navBuy} · ${t.navSell} · ${t.navRent}`}>
 {t.doors.map(([title,text,action],i)=><a class="door" href={route(lang,doorPages[i])}><ServiceIcon index={doorIcons[i]}/><h2>{title}</h2><p>{text}</p><span class="small-link door-link">{action} <span aria-hidden="true">→</span></span></a>)}
</section>

<section class="how wrap" aria-labelledby="how-title">
 <h2 id="how-title">{t.howHeading}</h2>
 <ol class="how-steps">{t.howSteps.map(([title,text],i)=><li><span class="how-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{text}</p></li>)}</ol>
 <ArrowLink class="small-link" href={route(lang,'buy')}>{t.buyStepsHeading.replace(/\.$/,'')}</ArrowLink>
</section>

<section class="curated wrap" aria-labelledby="curated-title">
 <div class="section-head"><div><h2 id="curated-title">{t.selected}</h2><p class="section-note">{t.selectedNote}</p></div><ArrowLink class="small-link" href={route(lang,'properties')}>{t.viewAll}</ArrowLink></div>
 <div class="curated-grid">{featured.map(listing=>{const facade=facadeOf(listing,lang);const href=hrefOf(listing,lang);return <article class="curated-card">
  <a href={href} class="curated-image" tabindex="-1" aria-hidden="true"><Photo image={facade.image} alt={facade.alt} imageClass="curated-photo" sizes="(max-width:760px) 92vw, 30vw"/></a>
  <p class="curated-meta">{place(listing)} <span aria-hidden="true">·</span> {listing[lang].name}</p>
  <h3 class="curated-price"><a href={href}>{money(listing.price,lang)}<span class="visually-hidden"> · {listing[lang].name}</span></a></h3>
 </article>;})}</div>
</section>

<section class="rent-band" aria-labelledby="rent-title">
 <Photo image="area-west-hort" alt="" class="rent-photo" sizes="(max-width:760px) 100vw, 50vw"/>
 <div class="rent-copy"><p class="eyebrow">{t.rentEyebrow}</p><h2 id="rent-title">{t.rentHomeHeading}</h2><p>{t.rentHomeCopy}</p><ArrowLink class="small-link" href={route(lang,'rentals')}>{t.rentLink}</ArrowLink></div>
</section>

<section class="meet-band wrap" aria-labelledby="meet-title">
 <Photo image={homepage.portrait} alt={({en:'Portrait of Soumaya',es:'Retrato de Soumaya',fr:'Portrait de Soumaya'})[lang]} class="meet-photo meet-portrait" sizes="(max-width:760px) 60vw, 30vw"/>
 <div class="meet-text"><p class="eyebrow">{t.founderRole.toUpperCase()}</p><h2 id="meet-title">{t.meetHeading}</h2><p>{t.meetCopy}</p><ArrowLink class="small-link" href={route(lang,'about')}>{t.myStory}</ArrowLink></div>
</section>

<section class="private-conversation wrap" aria-labelledby="private-title">
 <p class="eyebrow">{t.privateEyebrow}</p><h2 id="private-title">{t.privateHeading}</h2><p>{t.privateCopy}</p>
 <ArrowLink class="button solid" href={route(lang,'contact')}>{t.startSearch}</ArrowLink>
</section>

<section class="perspective-band" aria-labelledby="perspective-title">
 <Photo image={homepage.perspective} alt="" class="perspective-photo" sizes="(max-width:760px) 100vw, 55vw"/>
 <div class="perspective-copy"><p class="eyebrow">{t.perspectiveEyebrow}</p><h2 id="perspective-title">{t.perspectiveHeading}</h2><p>{t.perspectiveCopy}</p><ArrowLink class="small-link" href={route(lang,'living')}>{t.perspectiveLink}</ArrowLink></div>
</section>
