---
// Four quiet line icons for the services, drawn at 20px in the text colour.
interface Props{index:number;}
const {index}=Astro.props;
---
<svg class="service-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
{index===0&&<Fragment><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></Fragment>}
{index===1&&<Fragment><path d="M3 11.5L12 4l9 7.5"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/></Fragment>}
{index===2&&<Fragment><rect x="5" y="10.5" width="14" height="10" rx="1"/><path d="M8 10.5V7.5a4 4 0 018 0v3"/><path d="M12 14.5v2.5"/></Fragment>}
{index===3&&<Fragment><rect x="3.5" y="5" width="17" height="15.5" rx="1"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/><path d="M7.5 13h2M11 13h2M14.5 13h2M7.5 16.5h2M11 16.5h2"/></Fragment>}
</svg>
