{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "trailingSlash": true,
  "functions": {
    "api/enquiry.mjs": {
      "includeFiles": "src/**"
    }
  },
  "redirects": [
    {
      "source": "/en/buy/",
      "destination": "/en/how-i-work/#buying",
      "permanent": true
    },
    {
      "source": "/en/sell/",
      "destination": "/en/how-i-work/#selling",
      "permanent": true
    },
    {
      "source": "/es/comprar/",
      "destination": "/es/como-trabajo/#buying",
      "permanent": true
    },
    {
      "source": "/es/vender/",
      "destination": "/es/como-trabajo/#selling",
      "permanent": true
    },
    {
      "source": "/fr/acheter/",
      "destination": "/fr/ma-methode/#buying",
      "permanent": true
    },
    {
      "source": "/fr/vendre/",
      "destination": "/fr/ma-methode/#selling",
      "permanent": true
    }
  ]
}
