{
  "name": "soumaya-ibiza",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-auba.mjs",
    "dev": "node scripts/sync-auba.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "node scripts/sync-auba.mjs && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "astro": "^7.3.5",
    "typescript": "^6.0.3"
  }
}
