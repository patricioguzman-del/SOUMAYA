# Leave false until content, contact details and legal pages are ready.
PUBLIC_SITE_LIVE=false
# Listings come from AUBA on every build (scripts/sync-auba.mjs).
# On Vercel: a read-only GitHub token with access to patricioguzman-del/auba-ibiza (Contents: read).
AUBA_GITHUB_TOKEN=
AUBA_REPO=patricioguzman-del/auba-ibiza
AUBA_REF=main
# Locally you can point at a folder instead: AUBA_SOURCE_DIR=/path/to/auba-ibiza/website
# Direct delivery of the enquiry letter (optional; without it the visitor's email app opens).
RESEND_API_KEY=
ENQUIRY_TO=
ENQUIRY_FROM=
